# Public origin of the storefront, used for canonical URLs, the sitemap and structured data.
# Falls back to the Vercel production domain, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Laravel backend origin (see backend/). Leave empty to serve the bundled demo catalog.
API_URL=http://localhost:8000

# Shared with the backend's STOREFRONT_REVALIDATE_SECRET.
REVALIDATE_SECRET=

# One-click demo accounts on the login page. Keep disabled in production.
DEMO_LOGIN_ENABLED=false
# Must equal the backend's SEED_DEMO_PASSWORD.
DEMO_PASSWORD=
